# Neon -> your project -> Connection details.
# DATABASE_URL: the POOLED string (host contains "-pooler"). Used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL: the DIRECT string (no "-pooler"). Used by `npm run migrate`.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Long random text that signs login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Used once by `npm run seed` to create the first Creator login.
SEED_CREATOR_USERNAME=creator
SEED_CREATOR_NAME=HTL Creator
SEED_CREATOR_PASSWORD=
